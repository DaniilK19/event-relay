<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Shared by the four runnable projects: local secrets are set once (see README, "Run without Docker"). -->
    <UserSecretsId>eventrelay-local-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventRelay.Infrastructure\EventRelay.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Only needed by the `dotnet ef` tooling; never shipped at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
