{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },
  "Simulator": {
    "EventRelayUrl": "http://localhost:5080",
    "ApiKey": "",
    "Interval": "00:00:03",
    "DuplicateRate": 0.1,
    "Source": "flight-status-simulator"
  }
}
