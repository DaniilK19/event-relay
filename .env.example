# Settings for docker-compose.yml. Copy to `.env` (git-ignored) and replace every change-me value,
# e.g. with the output of `openssl rand -hex 32`. Never commit `.env` or put real credentials here.
# docker compose refuses to start while a required value is missing.

# PostgreSQL used by the API and the dispatcher
POSTGRES_DB=eventrelay
POSTGRES_USER=eventrelay
POSTGRES_PASSWORD=change-me-postgres-password

# SQL Server that backs the Service Bus emulator.
# Must satisfy SQL Server password rules: 8+ characters from 3 of: upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=Change_Me_Sql_Password_1

# EventRelay API keys (X-Api-Key header), 32+ characters each.
# Publisher: POST /events (used by the simulator). Admin: everything, including /subscriptions.
PUBLISHER_API_KEY=change-me-publisher-key-at-least-32-chars
ADMIN_API_KEY=change-me-admin-key-at-least-32-characters

# Master secret of the sample WebhookReceiver (16+ characters). It derives a separate signing secret
# for each of its subscriptions from this value and registers those with EventRelay.
WEBHOOK_SECRET=change-me-webhook-signing-secret

# Optional
# Share of requests the receiver's /webhooks/flaky endpoint fails with 503 (0.0 - 1.0)
FLAKY_FAILURE_RATE=0.3
# Pause between simulated flight events (hh:mm:ss)
SIMULATOR_INTERVAL=00:00:03
