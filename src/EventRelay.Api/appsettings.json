{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Azure": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "ServiceBus": ""
  },
  "ApiKeys": {
    "Publisher": [],
    "Admin": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ServiceBus": {
    "TopicName": "events"
  },
  "Outbox": {
    "PollingInterval": "00:00:00.500",
    "BatchSize": 100
  },
  "Webhooks": {
    "AllowedHosts": [],
    "RequireHttps": true,
    "AllowPrivateNetworks": false
  }
}
