{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Receiver": {
    "EventRelayUrl": "http://localhost:5080",
    "ApiKey": "",
    "PublicBaseUrl": "http://localhost:5081",
    "Secret": "",
    "SignatureTolerance": "00:05:00",
    "FlakyFailureRate": 0.3,
    "RegisterSubscriptions": true
  }
}
